# ---- Local mode (default): single user on this machine, no account setup needed.
# Leave OPENAI_API_KEY empty to run in demo mode (fixture data, no network).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Local token required on /api routes. Generated at startup if empty. Never used in remote mode.
APP_TOKEN=
APP_PORT=8765
DATA_ROOT=data
LOG_LEVEL=INFO
# Days to keep activity events and finished job rows (expired caches are always dropped).
RETENTION_DAYS=90
# Seconds running jobs get to finish on shutdown before being checkpointed as interrupted.
SHUTDOWN_GRACE_SECONDS=10
# Gmail OAuth client secret + token live outside the repo.
GMAIL_CREDENTIALS=~/.config/outreach/credentials.json
GMAIL_TOKEN=~/.config/outreach/token.json

# ---- Remote mode (optional): see docs/remote-deployment.md. Requires HTTPS.
# HERMES_MODE=remote
# HERMES_PUBLIC_URL=https://hermes.example.org
# HERMES_SECRET_KEY=            # python -m app.ops gen-secret-key; keep it OUT of DATA_ROOT and backups
# HERMES_TRUSTED_PROXIES=127.0.0.1
# APP_HOST=127.0.0.1            # bind behind the reverse proxy
