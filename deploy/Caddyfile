# Caddy terminates TLS (automatic Let's Encrypt certificates) and forwards to HERMES on loopback.
hermes.example.org {
	encode gzip
	reverse_proxy 127.0.0.1:8765 {
		header_up X-Forwarded-Proto https
	}
	request_body {
		# Must exceed the base64 form of the 10 MiB attachment limit (~13.4 MiB) in app/workspace.py.
		max_size 15MiB
	}
}
